---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
  /** Page-level titles use 1; section titles default to 2. */
  headingLevel?: 1 | 2;
}

const {
  eyebrow,
  title,
  desc,
  titleId,
  centered = false,
  wide = false,
  headingLevel = 2,
} = Astro.props;

const HeadingTag = headingLevel === 1 ? 'h1' : 'h2';
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <HeadingTag id={titleId} class="section-header__title">{title}</HeadingTag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
